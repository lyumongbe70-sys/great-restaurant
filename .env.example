# ==============================================================================
# 클라이언트 환경변수 (VITE_ 접두사: 브라우저에 노출됨)
# ==============================================================================

# 카카오 지도 JavaScript 키 (카카오 개발자 콘솔: https://developers.kakao.com)
VITE_KAKAO_MAP_API_KEY=your_kakao_javascript_api_key_here

# Supabase 클라이언트 접속 정보 (RLS 정책에 의해 SELECT 조회만 가능)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# 소상공인시장진흥공단_상가(상권)정보 Open API (https://data.go.kr)
VITE_SEMAS_API_KEY=your_semas_service_key_here
VITE_SEMAS_BASE_URL=https://apis.data.go.kr/B553077/api/open/sdsc2

# ==============================================================================
# 서버 전용 비밀키 (VITE_ 접두사 없음: 브라우저에 절대 노출되지 않음!)
# 데이터 수집 및 DB Upsert(쓰기/수정) 권한을 가진 Secret Key
# (Supabase 대시보드 > Project Settings > API > service_role 비밀키)
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
